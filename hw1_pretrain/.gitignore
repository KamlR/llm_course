# Publish only the report and its linked artifacts from each experiment.
# Add an exception here when a report links to a new artifact.
/experiments/*/*
!/experiments/*/report.md
!/experiments/*/loss.png
!/experiments/*/results.json
!/experiments/*/eval_results.json
!/experiments/*/train_results.json
